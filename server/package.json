{
	"name": "@znajdzprace/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.11.0"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"build": "tsc",
		"start": "node --env-file-if-exists=.env dist/server.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"db:check": "tsx --env-file-if-exists=.env src/db/check.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2"
	}
}
