{
	"name": "@znajdzprace/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.11.0"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"build": "tsc",
		"start": "node --env-file-if-exists=.env dist/server.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint ."
	},
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2"
	}
}
